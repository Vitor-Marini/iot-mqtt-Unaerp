# Ambiente full local (docker-compose.yml da raiz).
# Copie para .env e ajuste. O .env nao e versionado.
#   cp .env.example .env

# ------------------------------------------------------------------ Portas --
MQTT_PORT=1883
INFLUXDB_PORT=8086
GRAFANA_PORT=3000
OTA_PORT=8080

# -------------------------------------------------------------- OTA Server --
# IP da sua máquina que o ESP32 consegue acessar via rede Wi-Fi local
OTA_EXTERNAL_HOST=192.168.1.100

# -------------------------------------------------------------- Subscriber --
# Client ID no broker. Precisa ser unico entre os clientes MQTT.
SUBSCRIBER_ID=DB_SUBSCRIBER

# ------------------------------------------------------- Healthcheck monitor -
# Este servico abre uma JANELA Tkinter e esta no profile `gui`: nao sobe com
# `make up`. Ver services/healthcheck-monitor/README.md.
#
# Client ID proprio: dois clientes com o mesmo ID se expulsam no broker.
MONITOR_CLIENT_ID=healthcheck-monitor
# Onde a janela e desenhada, se voce rodar em container:
#   Linux  : :0
#   Windows: host.docker.internal:0.0  (exige VcXsrv no host)
DISPLAY=:0

# ---------------------------------------------------------------- InfluxDB --
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=troque-esta-senha
INFLUXDB_ORG=esp32
INFLUXDB_BUCKET=sensors
# 0 = guarda para sempre. Ex.: 30d, 90d.
INFLUXDB_RETENTION=0
# Gere um proprio:  openssl rand -base64 48 | tr -d '\n='
# Este mesmo valor e usado pelo subscriber (TOKEN_INFLUX) e pelo Grafana.
INFLUXDB_TOKEN=gere-um-token-proprio

# ----------------------------------------------------------------- Grafana --
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
