# Ambiente de desenvolvimento (docker-compose.yml da raiz).
# Copie para .env e ajuste. O .env não é versionado.
#   cp .env.example .env

# ------------------------------------------------------------------ Portas --
MQTT_PORT=1883
SUBSCRIBER_PORT=2112
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# -------------------------------------------------------------------- MQTT --
MQTT_CLIENT_ID=subscriber-estacao
MQTT_TELEMETRY_TOPIC=/telemetry
MQTT_HEALTH_TOPIC=/health-check
MQTT_QOS=1

# --------------------------------------------------------------- Subscriber -
SENSOR_STALE_AFTER=90s
LOG_LEVEL=info

# --------------------------------------------------------------- Prometheus -
PROMETHEUS_RETENTION=15d

# ------------------------------------------------------------------ Grafana -
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
