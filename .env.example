# Ambiente full local (docker-compose.yml da raiz).
# Copie para .env e ajuste. O .env nao e versionado.
#   cp .env.example .env

# ------------------------------------------------------------------ Portas --
MQTT_PORT=1883
INFLUXDB_PORT=8086
GRAFANA_PORT=3000

# -------------------------------------------------------------- Subscriber --
# Client ID no broker. Precisa ser unico entre os clientes MQTT.
SUBSCRIBER_ID=DB_SUBSCRIBER

# ---------------------------------------------------------------- InfluxDB --
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=troque-esta-senha
INFLUXDB_ORG=esp32
INFLUXDB_BUCKET=sensors
# 0 = guarda para sempre. Ex.: 30d, 90d.
INFLUXDB_RETENTION=0
# Gere um proprio:  openssl rand -base64 48 | tr -d '\n='
# Este mesmo valor e usado pelo subscriber (TOKEN_INFLUX) e pelo Grafana.
INFLUXDB_TOKEN=gere-um-token-proprio

# ----------------------------------------------------------------- Grafana --
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
