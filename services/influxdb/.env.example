# Copie para .env e ajuste. O .env nao e versionado.
#   cp .env.example .env

# Porta publicada no host.
INFLUXDB_PORT=8086

# Credenciais do primeiro boot. Aplicadas SOMENTE quando o volume esta vazio:
# depois disso, trocar aqui nao muda nada (ver README).
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=troque-esta-senha

# Organizacao e bucket. Precisam bater com o .env do subscriber.
INFLUXDB_ORG=esp32
INFLUXDB_BUCKET=sensors

# 0 = guarda para sempre. Ex.: 30d, 90d.
INFLUXDB_RETENTION=0

# Token de admin. Gere um proprio com:
#   openssl rand -base64 48 | tr -d '\n='
# O mesmo valor vai no INFLUX_TOKEN do subscriber e do Grafana.
INFLUXDB_TOKEN=gere-um-token-proprio
