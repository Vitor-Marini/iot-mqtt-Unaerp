# Copie para .env e ajuste.
#   cp .env.example .env

# Porta publicada no host.
GRAFANA_PORT=3000

# Credenciais do administrador. TROQUE A SENHA fora do laboratório.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Máquina que roda o serviço `prometheus`. Em outra máquina, use o IP:
#   PROMETHEUS_URL=http://192.168.0.30:9090
PROMETHEUS_URL=http://prometheus:9090
