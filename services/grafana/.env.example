# Copie para .env e ajuste. O .env nao e versionado.
#   cp .env.example .env

# Porta publicada no host.
GRAFANA_PORT=3000

# Credenciais do administrador. TROQUE A SENHA fora do laboratorio.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Onde esta o InfluxDB, DO PONTO DE VISTA do container do Grafana:
#
#   compose da raiz (stack junta) .................. http://influxdb:8086
#   influxdb na MESMA maquina, outro compose ....... http://host.docker.internal:8086
#   influxdb em OUTRA maquina ...................... http://192.168.0.30:8086
#
# `localhost` NUNCA funciona aqui: dentro do container e o proprio container.
# Tabela completa em docs/deployment.md.
INFLUXDB_URL=http://host.docker.internal:8086

# Precisam bater com o .env do servico influxdb.
INFLUXDB_ORG=esp32
INFLUXDB_BUCKET=sensors
INFLUXDB_TOKEN=o-mesmo-token-do-influxdb
