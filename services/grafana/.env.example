# Copie para .env e ajuste. O .env nao e versionado.
#   cp .env.example .env

# Porta publicada no host.
GRAFANA_PORT=3000

# Credenciais do administrador. TROQUE A SENHA fora do laboratorio.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Maquina que roda o servico `influxdb`. Em outra maquina, use o IP:
#   INFLUXDB_URL=http://192.168.0.30:8086
INFLUXDB_URL=http://influxdb:8086

# Precisam bater com o .env do servico influxdb.
INFLUXDB_ORG=esp32
INFLUXDB_BUCKET=sensors
INFLUXDB_TOKEN=o-mesmo-token-do-influxdb
