        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "t_max = from(bucket: \"sensors\")\n  |> range(start: 0)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"temperature\")\n  |> filter(fn: (r) => r.sensor_id =~ /^${sensor_id:regex}$/)\n  |> max()\n  |> keep(columns: [\"sensor_id\", \"_value\"])\n  |> rename(columns: {_value: \"max_val\"})\n\nt_min = from(bucket: \"sensors\")\n  |> range(start: 0)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"temperature\")\n  |> filter(fn: (r) => r.sensor_id =~ /^${sensor_id:regex}$/)\n  |> min()\n  |> keep(columns: [\"sensor_id\", \"_value\"])\n  |> rename(columns: {_value: \"min_val\"})\n\njoin(tables: {t1: t_max, t2: t_min}, on: [\"sensor_id\"])\n  |> map(fn: (r) => ({\n      sensor_id: r.sensor_id,\n      _field: \"amplitude\",\n      _value: r.max_val - r.min_val\n  }))",
          "refId": "A"
        }
      ],
      "title": "Amplitude Térmica (ΔT)",
      "type": "stat"
    },
