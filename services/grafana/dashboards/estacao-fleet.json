          },
          "query": "from(bucket: \"sensors\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"healthcheck\" and r._field == \"status\")\n  |> filter(fn: (r) => r.device_name =~ /^(${device:regex})$/)\n  |> group(columns: [\"device_id\", \"device_name\"])\n  |> last()\n  |> map(fn: (r) => ({\n        device_id:   r.device_id,\n        device_name: r.device_name,\n        last_seen:   r._time,\n        silencio_s:  int(v: uint(v: now()) - uint(v: r._time)) / 1000000000,\n     }))\n  |> group()\n  |> sort(columns: [\"silencio_s\"], desc: true)"
        }
      ],
      "description": "Janela fixa de 30d de proposito: um painel de deteccao de queda nao pode depender do seletor de tempo, senao olhar now-1h esconde exatamente a placa que voce procura. O firmware nao registra LWT.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "device_name": 0,
              "device_id": 1,
              "silencio_s": 2,
              "last_seen": 3
