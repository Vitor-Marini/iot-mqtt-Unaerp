# Copie para .env e ajuste. O .env nao e versionado.
#   cp .env.example .env
#
# O codigo carrega este arquivo via godotenv e tambem aceita as mesmas chaves
# como variaveis de ambiente (e o que o docker-compose faz).

# ------------------------------------------------------------------ MQTT ----
# Onde esta o broker, DO PONTO DE VISTA deste processo:
#
#   compose da raiz (stack junta) .................. mosquitto
#   container, broker na MESMA maquina ............. host.docker.internal
#   container, broker em OUTRA maquina ............. o IP dela, ex 192.168.0.10
#   rodando no host (go run .) ..................... localhost
#
# `localhost` NUNCA funciona de dentro de um container: ali e o proprio
# container. Tabela completa em docs/deployment.md.
MQTT_HOST=host.docker.internal
MQTT_PORT=1883
# Client ID no broker. Precisa ser unico: o broker expulsa o cliente anterior
# que usar o mesmo ID.
SUBSCRIBER_ID=DB_SUBSCRIBER

# -------------------------------------------------------------- InfluxDB ----
# Obrigatorias: o codigo nao tem valores padrao para estas quatro.
# Mesma regra do MQTT_HOST acima:
#   compose da raiz ................................ http://influxdb:8086
#   container, influxdb na MESMA maquina ........... http://host.docker.internal:8086
#   container, influxdb em OUTRA maquina ........... http://192.168.0.30:8086
#   rodando no host ................................ http://localhost:8086
INFLUX_HOST=http://host.docker.internal:8086
# O mesmo token definido em services/influxdb/.env (INFLUXDB_TOKEN).
TOKEN_INFLUX=

INFLUX_ORG=esp32
INFLUX_BUCKET=sensors
