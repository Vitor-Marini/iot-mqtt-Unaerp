# Copie para .env e ajuste. O .env não é versionado.
#   cp .env.example .env

# ------------------------------------------------------------------ MQTT ----
# Máquina que roda o serviço `mosquitto`. Em outra máquina, troque pelo IP.
MQTT_BROKER_URL=tcp://mosquitto:1883
MQTT_CLIENT_ID=subscriber-estacao
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TELEMETRY_TOPIC=/telemetry
MQTT_HEALTH_TOPIC=/health-check
MQTT_QOS=1

# --------------------------------------------------------------- Métricas ---
METRICS_ADDR=:2112
METRICS_PATH=/metrics
# Porta publicada no host pelo docker-compose deste serviço.
SUBSCRIBER_PORT=2112

# --------------------------------------------------------------- Operação ---
# Sem mensagem válida por este tempo, o sensor é marcado offline.
SENSOR_STALE_AFTER=90s
LOG_LEVEL=info
