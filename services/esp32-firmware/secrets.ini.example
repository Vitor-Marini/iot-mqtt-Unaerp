[secrets]
wifi_ssid = YourWiFiSSID
wifi_pass = YourWiFiPassword
mqtt_host = 192.168.1.100
mqtt_port = 1883
mqtt_user = ""
mqtt_pass = ""
mqtt_topic_base = devices

; Nome legivel desta placa. Vira a tag `device_name` no InfluxDB e e o que
; aparece na legenda e no seletor do Grafana, em vez do MAC.
;
; DUAS REGRAS:
;   - No maximo 24 caracteres. O payload de health-check ja usa 183 dos 256
;     bytes do buffer de serializacao; nomes longos truncam o JSON em silencio.
;   - UNICO por placa. O seletor do Grafana filtra por este valor, entao dois
;     dispositivos com o mesmo nome se fundem num item.
;
; Use apenas letras, numeros, ponto, hifen e underscore: o valor vai para uma
; tag do InfluxDB e para uma regex do Grafana.
;
; Deixe vazio para a placa se identificar pelo proprio MAC.
device_name = Estacao-Lab-01
sensor_read_interval_ms = 5000
health_check_interval_ms = 30000
